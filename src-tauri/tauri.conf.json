{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScribeTrace",
  "version": "0.1.0",
  "identifier": "org.scribetrace.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "deb": {
        "desktopTemplate": "desktop.template"
      }
    }
  },
  "app": {
    "windows": [{ "title": "ScribeTrace", "width": 1000, "height": 700 }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  }
}
