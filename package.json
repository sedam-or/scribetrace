    "lint": "node tools/lint-ui-boundaries.mjs && node --test \"tools/*.test.mjs\"",
    "test": "tsc -p tsconfig.test.json && node --test \".test-out/tests-ui/*.test.js\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
