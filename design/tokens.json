{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "ScribeTrace Design Tokens",
  "version": "1.0.0",
  "description": "Design tokens for ScribeTrace calm, dense desktop application, in W3C DTCG format.",
  "color": {
    "base": {
      "white": { "$value": "#ffffff", "$type": "color" },
      "black": { "$value": "#000000", "$type": "color" },
      "slate": {
        "50": { "$value": "#f8fafc", "$type": "color" },
        "100": { "$value": "#f1f5f9", "$type": "color" },
        "200": { "$value": "#e2e8f0", "$type": "color" },
        "300": { "$value": "#cbd5e1", "$type": "color" },
        "400": { "$value": "#94a3b8", "$type": "color" },
        "500": { "$value": "#64748b", "$type": "color" },
        "600": { "$value": "#475569", "$type": "color" },
        "700": { "$value": "#334155", "$type": "color" },
        "800": { "$value": "#1e293b", "$type": "color" },
        "900": { "$value": "#0f172a", "$type": "color" }
      },
      "blue": {
        "300": { "$value": "#93c5fd", "$type": "color" },
        "400": { "$value": "#60a5fa", "$type": "color" },
        "500": { "$value": "#3b82f6", "$type": "color" },
        "600": { "$value": "#2563eb", "$type": "color" },
        "700": { "$value": "#1d4ed8", "$type": "color" },
        "800": { "$value": "#1e40af", "$type": "color" }
      },
      "emerald": {
        "400": { "$value": "#4ade80", "$type": "color" },
        "500": { "$value": "#22c55e", "$type": "color" },
        "600": { "$value": "#16a34a", "$type": "color" },
        "700": { "$value": "#15803d", "$type": "color" },
        "800": { "$value": "#166534", "$type": "color" },
        "900": { "$value": "#14532d", "$type": "color" }
      },
      "amber": {
        "400": { "$value": "#fbbf24", "$type": "color" },
        "500": { "$value": "#f59e0b", "$type": "color" },
        "600": { "$value": "#d97706", "$type": "color" },
        "700": { "$value": "#b45309", "$type": "color" },
        "800": { "$value": "#92400e", "$type": "color" }
      },
      "rose": {
        "400": { "$value": "#f87171", "$type": "color" },
        "500": { "$value": "#ef4444", "$type": "color" },
        "600": { "$value": "#dc2626", "$type": "color" },
        "700": { "$value": "#b91c1c", "$type": "color" },
        "800": { "$value": "#991b1b", "$type": "color" }
      }
    },
    "semantic": {
      "light": {
        "canvas": { "$value": "{color.base.white}", "$type": "color" },
        "surface": { "$value": "{color.base.slate.50}", "$type": "color" },
        "surfaceRaised": { "$value": "{color.base.white}", "$type": "color" },
        "textPrimary": { "$value": "{color.base.slate.900}", "$type": "color" },
        "textSecondary": { "$value": "{color.base.slate.600}", "$type": "color" },
        "textMuted": { "$value": "{color.base.slate.500}", "$type": "color" },
        "border": { "$value": "{color.base.slate.300}", "$type": "color" },
        "borderSubtle": { "$value": "{color.base.slate.200}", "$type": "color" },
        "primary": { "$value": "{color.base.blue.700}", "$type": "color" },
        "primaryHover": { "$value": "{color.base.blue.800}", "$type": "color" },
        "focusRing": { "$value": "{color.base.blue.600}", "$type": "color" },
        "markAdded": { "$value": "{color.base.emerald.700}", "$type": "color" },
        "markAddedBg": { "$value": "#ecfdf5", "$type": "color" },
        "markEdited": { "$value": "{color.base.amber.700}", "$type": "color" },
        "markEditedBg": { "$value": "#fffbeb", "$type": "color" },
        "markRemoved": { "$value": "{color.base.rose.700}", "$type": "color" },
        "markRemovedBg": { "$value": "#fef2f2", "$type": "color" },
        "errorText": { "$value": "{color.base.rose.700}", "$type": "color" },
        "errorBg": { "$value": "#fef2f2", "$type": "color" },
        "errorBorder": { "$value": "#fecaca", "$type": "color" }
      },
      "dark": {
        "canvas": { "$value": "{color.base.slate.900}", "$type": "color" },
        "surface": { "$value": "{color.base.slate.800}", "$type": "color" },
        "surfaceRaised": { "$value": "{color.base.slate.700}", "$type": "color" },
        "textPrimary": { "$value": "{color.base.slate.50}", "$type": "color" },
        "textSecondary": { "$value": "{color.base.slate.400}", "$type": "color" },
        "textMuted": { "$value": "{color.base.slate.400}", "$type": "color" },
        "border": { "$value": "{color.base.slate.700}", "$type": "color" },
        "borderSubtle": { "$value": "{color.base.slate.800}", "$type": "color" },
        "primary": { "$value": "{color.base.blue.400}", "$type": "color" },
        "primaryHover": { "$value": "{color.base.blue.300}", "$type": "color" },
        "focusRing": { "$value": "{color.base.blue.400}", "$type": "color" },
        "markAdded": { "$value": "{color.base.emerald.400}", "$type": "color" },
        "markAddedBg": { "$value": "#064e3b", "$type": "color" },
        "markEdited": { "$value": "{color.base.amber.400}", "$type": "color" },
        "markEditedBg": { "$value": "#78350f", "$type": "color" },
        "markRemoved": { "$value": "{color.base.rose.400}", "$type": "color" },
        "markRemovedBg": { "$value": "#450a0a", "$type": "color" },
        "errorText": { "$value": "{color.base.rose.400}", "$type": "color" },
        "errorBg": { "$value": "#450a0a", "$type": "color" },
        "errorBorder": { "$value": "#991b1b", "$type": "color" }
      }
    }
  },
  "spacing": {
    "0": { "$value": "0px", "$type": "dimension" },
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "20px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" }
  },
  "typography": {
    "fontFamily": {
      "sans": {
        "$value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
        "$type": "fontFamily"
      },
      "mono": {
        "$value": "ui-monospace, SFMono-Regular, 'Cascadia Code', 'Liberation Mono', Menlo, Consolas, monospace",
        "$type": "fontFamily"
      }
    },
    "fontSize": {
      "xs": { "$value": "11px", "$type": "dimension" },
      "sm": { "$value": "12px", "$type": "dimension" },
      "base": { "$value": "13px", "$type": "dimension" },
      "md": { "$value": "14px", "$type": "dimension" },
      "lg": { "$value": "16px", "$type": "dimension" },
      "xl": { "$value": "18px", "$type": "dimension" },
      "2xl": { "$value": "22px", "$type": "dimension" }
    },
    "fontWeight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight" }
    },
    "lineHeight": {
      "tight": { "$value": 1.25, "$type": "number" },
      "normal": { "$value": 1.45, "$type": "number" },
      "relaxed": { "$value": 1.6, "$type": "number" }
    }
  },
  "borderRadius": {
    "none": { "$value": "0px", "$type": "dimension" },
    "sm": { "$value": "3px", "$type": "dimension" },
    "md": { "$value": "5px", "$type": "dimension" },
    "lg": { "$value": "8px", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "shadow": {
    "subtle": { "$value": "0 1px 2px rgba(0, 0, 0, 0.05)", "$type": "shadow" },
    "modal": { "$value": "0 4px 12px rgba(0, 0, 0, 0.15)", "$type": "shadow" }
  },
  "transition": {
    "fast": { "$value": "100ms cubic-bezier(0, 0, 0.2, 1)", "$type": "transition" },
    "normal": { "$value": "150ms cubic-bezier(0, 0, 0.2, 1)", "$type": "transition" }
  }
}
