{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "scribetrace-spike-tauri-webview",
  "version": "0.1.0",
  "identifier": "com.scribetrace.spike4",
  "build": {
    "frontendDist": "ui"
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "ScribeTrace Spike 4 WebView",
        "width": 1024,
        "height": 768,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' data: blob:"
    }
  }
}
